---
// Hero illustration: the data model at a glance, as an excerpt from the
// middle of a workflow — neighbouring tiles clipped by the card edge, wires
// running in and out. Two n8n-style Code nodes; beneath each, the TypeScript
// file named after it (kebab-cased), with an injection arrow feeding its
// source up into the node. Static, one compact SVG that stays legible at
// phone scale.
---

<div class="mx-auto w-full max-w-3xl overflow-hidden rounded-xl border border-zinc-800 bg-zinc-950 py-4 shadow-lg sm:py-6">
  <svg
    id="node-file-hero"
    viewBox="0 0 420 268"
    role="img"
    aria-label="Illustration: an excerpt from the middle of an n8n workflow — wires enter from the left and leave to the right past clipped neighbouring nodes. Two Code nodes, Normalize order and Score risk; beneath each sits the TypeScript file named after it, normalize-order.ts and score-risk.ts, with an arrow feeding its code up into the node. Caption: one file per Code node, named after it."
    class="h-auto w-full"
  >
    <defs>
      <marker id="nfh-dim" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M0,0L10,5L0,10z" fill="#52525b"></path>
      </marker>
      <marker id="nfh-grn" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M0,0L10,5L0,10z" fill="#34d399"></path>
      </marker>
    </defs>

    <!-- clipped neighbours — the workflow continues on both sides -->
    <rect x="-30" y="36" width="44" height="56" rx="10" fill="#18181b" stroke="#3f3f46"></rect>
    <rect x="406" y="36" width="44" height="56" rx="10" fill="#18181b" stroke="#3f3f46"></rect>

    <!-- node names, above the tiles to keep the injection lane clear -->
    <text x="148" y="26" text-anchor="middle" class="w s11">Normalize order</text>
    <text x="300" y="26" text-anchor="middle" class="w s11">Score risk</text>

    <!-- workflow row -->
    <rect x="120" y="36" width="56" height="56" rx="10" fill="#27272a" stroke="#52525b"></rect>
    <text x="148" y="72" text-anchor="middle" class="w s16">{"{ }"}</text>
    <rect x="272" y="36" width="56" height="56" rx="10" fill="#27272a" stroke="#52525b"></rect>
    <text x="300" y="72" text-anchor="middle" class="w s16">{"{ }"}</text>

    <line x1="14" y1="64" x2="116" y2="64" stroke="#52525b" stroke-width="1.5" marker-end="url(#nfh-dim)"></line>
    <line x1="176" y1="64" x2="268" y2="64" stroke="#52525b" stroke-width="1.5" marker-end="url(#nfh-dim)"></line>
    <line x1="328" y1="64" x2="402" y2="64" stroke="#52525b" stroke-width="1.5" marker-end="url(#nfh-dim)"></line>

    <!-- injection arrows, file → node -->
    <line x1="148" y1="182" x2="148" y2="98" stroke="#34d399" stroke-width="1.5" marker-end="url(#nfh-grn)"></line>
    <line x1="300" y1="182" x2="300" y2="98" stroke="#34d399" stroke-width="1.5" marker-end="url(#nfh-grn)"></line>

    <!-- file row -->
    <rect x="82" y="186" width="132" height="32" rx="6" fill="#09090b" stroke="#34d399" stroke-opacity="0.45"></rect>
    <text x="148" y="206" text-anchor="middle" class="w s11">normalize-order.ts</text>
    <rect x="248" y="186" width="104" height="32" rx="6" fill="#09090b" stroke="#34d399" stroke-opacity="0.45"></rect>
    <text x="300" y="206" text-anchor="middle" class="w s11">score-risk.ts</text>

    <text x="210" y="252" text-anchor="middle" class="dim s11">one file per Code node — named after it</text>
  </svg>
</div>

<style>
  #node-file-hero text {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 12px;
    fill: #f4f4f5;
  }
  #node-file-hero .s11 { font-size: 11px; }
  #node-file-hero .s16 { font-size: 16px; }
  #node-file-hero .w { fill: #f4f4f5; }
  #node-file-hero .dim { fill: #71717a; }
</style>
