---
// Hero illustration: the diff you can't read. A fake `git diff` of a workflow
// JSON where a ~40-line logic rewrite is ONE changed string — truncated by the
// card, divergence point deep enough that the visible prefixes are identical —
// next to a 20-pixel position nudge that diffs perfectly. Dramatizes the
// problem only: no product, no vocabulary the article hasn't introduced yet.
// Static on purpose (the demos animate; the hero keeps still), plain HTML so
// it reflows on any width.
//
// The long lines live here as consts: their braces would otherwise be parsed
// as expressions in the template.
const minus =
  '-      "jsCode": "const orders = $input.all();\\nconst seen = new Set();\\nfor (const o of orders) { if (seen.has(o.json.id)) continue; seen.add(o.json.id); const risk = scoreRisk(o.json, { velocity: velocity(o), geo: geoRisk(o) }); if (risk > 0.8) flagged.push(o);…';
const plus =
  '+      "jsCode": "const orders = $input.all();\\nconst seen = new Set();\\nfor (const o of orders) { if (seen.has(o.json.id)) continue; seen.add(o.json.id); const risk = scoreRisk(await enrich(o.json), { velocity: velocity(o), geo: geoRisk(o), tier: o.json.tier });…';
---

<div class="mx-auto w-full max-w-3xl overflow-hidden rounded-xl border border-zinc-800 bg-zinc-950 shadow-lg">
  <div class="flex items-center gap-2 border-b border-zinc-800 px-4 py-2.5">
    <span class="h-3 w-3 rounded-full bg-red-500/80"></span>
    <span class="h-3 w-3 rounded-full bg-yellow-500/80"></span>
    <span class="h-3 w-3 rounded-full bg-green-500/80"></span>
    <span class="ml-2 font-mono text-xs text-zinc-500">git diff — order-sync/workflow.json</span>
  </div>
  <div id="diff-hero" class="px-4 py-3 font-mono text-[12px] leading-[1.7] text-zinc-100 sm:text-[13px]">
    <div class="dim">@@ node "Score risk" @@</div>
    <div class="del truncate">{minus}</div>
    <div class="add truncate">{plus}</div>
    <div class="dim">&nbsp;&nbsp;1 line changed · 2,741 → 2,893 chars</div>
    <div class="dim mt-3">@@ node "Normalize" @@</div>
    <div class="del">-      "position": [420, 300]</div>
    <div class="add">+      "position": [440, 300]</div>
    <div class="dim mt-3 border-t border-zinc-800 pt-2">a 40-line rewrite · a 20-pixel nudge — same diff</div>
  </div>
</div>

<style>
  #diff-hero .dim { color: #71717a; }
  #diff-hero .del { color: #f87171; }
  #diff-hero .add { color: #34d399; }
</style>
