#!/usr/bin/env node
// SessionStart config-drift detector (Plan 33): warn when an agent MCP config
// in this sync dir — or in the user-level config of a known harness (Plan 58
// task 2) — points at an n8n instance MCP endpoint DIRECTLY instead of the
// decanter guard-proxy. Deliberately slim — it inspects config files, not
// tool calls (the proxy itself enforces the jsCode boundary). Exit 0 always:
// this is guidance, not a gate. Harness-agnostic: any agent hook system (or a
// shell profile) can run `node .claude/hooks/mcp-route-check.mjs`.
import { existsSync, readFileSync } from "node:fs";
import { homedir } from "node:os";
import path from "node:path";

/** Project-scoped agent MCP config files (harness variety, n8n-io/skills style). */
const CONFIG_FILES = [".mcp.json", ".cursor/mcp.json", ".vscode/mcp.json", "opencode.json"];

/**
 * User-scoped counterparts — the "second door" no project file shows:
 * `claude mcp add -s user` (and its per-project entries), Cursor's global
 * config, the VS Code user profile, opencode's global config. Labels stay
 * `~/…` so the warning names the file the way the user knows it.
 */
function userConfigFiles() {
  const home = homedir();
  const files = [
    ["~/.claude.json", path.join(home, ".claude.json")],
    ["~/.cursor/mcp.json", path.join(home, ".cursor", "mcp.json")],
    ["~/.config/opencode/opencode.json", path.join(home, ".config", "opencode", "opencode.json")],
  ];
  if (process.platform === "darwin") {
    files.push(["~/Library/Application Support/Code/User/mcp.json", path.join(home, "Library", "Application Support", "Code", "User", "mcp.json")]);
  } else if (process.platform === "win32" && process.env.APPDATA) {
    files.push(["%APPDATA%/Code/User/mcp.json", path.join(process.env.APPDATA, "Code", "User", "mcp.json")]);
  } else {
    files.push(["~/.config/Code/User/mcp.json", path.join(home, ".config", "Code", "User", "mcp.json")]);
  }
  return files;
}

/** The running guard-proxy's endpoint, when `n8n-decanter mcp serve` is up. */
function proxyUrl() {
  try {
    return JSON.parse(readFileSync(".decanter-proxy.json", "utf8")).url ?? null;
  } catch {
    return null;
  }
}

function isLoopback(url) {
  try {
    const host = new URL(url).hostname;
    return host === "127.0.0.1" || host === "localhost" || host === "::1";
  } catch {
    return false;
  }
}

/** Collect every MCP server entry (name → config object) across known shapes. */
function serverEntries(config) {
  const bags = [config.mcpServers, config.mcp?.servers, config.servers];
  const entries = [];
  for (const bag of bags) {
    if (bag && typeof bag === "object") entries.push(...Object.entries(bag));
  }
  // opencode's shape is `mcp.<name>` directly (no `servers` nesting) — take its
  // object values, minus a `servers` container the bag above already read.
  if (config.mcp && typeof config.mcp === "object") {
    entries.push(...Object.entries(config.mcp).filter(([key, value]) => key !== "servers" && value && typeof value === "object"));
  }
  return entries;
}

function readJson(file) {
  if (!existsSync(file)) return null;
  try {
    return JSON.parse(readFileSync(file, "utf8"));
  } catch {
    return null; // unparseable config is some other tool's problem
  }
}

const proxy = proxyUrl();
const offenders = [];

/** Scan one parsed config; `label` is how the warning names the file. */
function scan(label, config) {
  for (const [name, server] of serverEntries(config)) {
    const text = JSON.stringify(server);
    // the built-in n8n MCP server's path is the giveaway; a loopback URL is
    // the guard-proxy (or a local tunnel the user chose) — leave those alone
    if (!text.includes("/mcp-server/http")) continue;
    const url = typeof server.url === "string" ? server.url : "";
    if (url !== "" && isLoopback(url)) continue;
    offenders.push({ file: label, name, url });
  }
}

for (const file of CONFIG_FILES) {
  const config = readJson(file);
  if (config) scan(file, config);
}
for (const [label, file] of userConfigFiles()) {
  const config = readJson(file);
  if (!config) continue;
  scan(label, config);
  // Claude Code's user file also carries per-project servers, keyed by
  // absolute project path — only this project's entry can route this session.
  const projectBag = config.projects?.[process.cwd()]?.mcpServers;
  if (projectBag && typeof projectBag === "object") {
    scan(`${label} (entry for this project)`, { mcpServers: projectBag });
  }
}

if (offenders.length > 0) {
  const target = proxy ?? "http://127.0.0.1:5680/mcp-server/http (start it: n8n-decanter mcp serve)";
  console.log(
    `n8n MCP routing check: ${offenders.map((o) => `"${o.name}" in ${o.file}`).join(", ")} ` +
      `points at an n8n instance MCP endpoint directly. Route it through the decanter guard instead — ` +
      `simplest: the stdio server ({"command":"npx","args":["--no-install","n8n-decanter","mcp","connect"]}, the scaffolded default); ` +
      `or for URL-based configs set its url to ${target} with the Authorization secret \`mcp serve\` prints. ` +
      `The guard forwards everything except Code-node (jsCode) writes, which belong to the file + \`n8n-decanter push\` flow.`,
  );
}
process.exit(0);
