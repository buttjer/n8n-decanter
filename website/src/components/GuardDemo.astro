---
// Looping simulation of the one blocked door: an agent adds and wires a node
// over n8n's MCP (forwarded), then tries to write `jsCode` (refused, with the
// guard's real guidance text), edits the file instead, and pushes. Same house
// pattern as AgentDemo/TerminalDemo — frames + ms, no framework, honors
// prefers-reduced-motion.
---

<div class="mx-auto w-full max-w-3xl overflow-hidden rounded-xl border border-zinc-800 bg-zinc-950 shadow-lg">
  <div class="flex items-center gap-2 border-b border-zinc-800 px-4 py-2.5">
    <span class="h-3 w-3 rounded-full bg-red-500/80"></span>
    <span class="h-3 w-3 rounded-full bg-yellow-500/80"></span>
    <span class="h-3 w-3 rounded-full bg-green-500/80"></span>
    <span class="ml-2 font-mono text-xs text-zinc-500">coding agent — Order enrichment</span>
  </div>
  <div
    id="guard-demo-body"
    role="img"
    aria-label="Animated demo: an agent adds and wires a node over n8n's MCP and the guard forwards it, then tries to write Code-node source and is refused and pointed at the file, edits that file, and pushes to the draft."
    class="h-[19rem] overflow-hidden px-4 py-3 font-mono text-[12px] leading-[1.6] text-zinc-100 sm:text-[13px]"
  ></div>
</div>

<style>
  #guard-demo-body :global(.who) { color: #a1a1aa; }
  #guard-demo-body :global(.you) { color: #60a5fa; }
  #guard-demo-body :global(.bot) { color: #c4b5fd; }
  #guard-demo-body :global(.tool) { color: #34d399; }
  #guard-demo-body :global(.add) { color: #34d399; }
  #guard-demo-body :global(.ok) { color: #34d399; }
  #guard-demo-body :global(.no) { color: #f87171; }
  #guard-demo-body :global(.dim) { color: #71717a; }
  #guard-demo-body :global(.blk) { margin-top: 0.5rem; }
</style>

<script>
  const body = document.getElementById("guard-demo-body");
  if (body) {
    // Each entry: [html, ms to linger before revealing the next].
    const steps: [string, number][] = [
      ['<div><span class="who you">▌ You</span></div><div>Add a fraud-risk score after Normalize order, then get it onto the draft.</div>', 1400],
      ['<div class="blk"><span class="who bot">▌ Agent</span></div><div class="dim">Building the structure in n8n, then writing the logic where logic lives.</div>', 1300],
      ['<div class="blk"><span class="tool">⏺ n8n MCP</span> update_workflow · addNode "Score risk" + addConnection</div><div class="ok">✓ forwarded — node created and wired</div>', 1700],
      ['<div class="blk"><span class="tool">⏺ n8n MCP</span> update_workflow · updateNodeParameters { jsCode }</div><div class="no">✗ blocked by the n8n-decanter guard-proxy</div><div class="dim">Code-node source (jsCode) is managed as files in this repo. Edit the node\'s file under workflows/&lt;workflow&gt;/code/ and run `n8n-decanter push`.</div>', 2500],
      ['<div class="blk"><span class="tool">⏺ Edit</span> workflows/order-enrichment/code/score-risk.ts</div><div class="add">+   const score = riskScore(order, { velocity, geo });</div><div class="add">+   return [{ json: { ...order, score, flagged: score > 0.8 } }];</div>', 1700],
      ['<div class="blk"><span class="tool">⏺ Run</span> n8n-decanter push "Order enrichment"</div><div class="ok">✓ pushed to the draft — publish when ready</div>', 1700],
      ['<div class="blk"><span class="who bot">▌ Agent</span></div><div>Done — structure in n8n, logic in git, both on the draft. The published version never moved.</div>', 2700],
    ];

    const render = (n: number) => {
      body.innerHTML = steps.slice(0, n).map((s) => s[0]).join("");
      // Keep the newest line in view — the panel scrolls, it doesn't resize.
      body.scrollTop = body.scrollHeight;
    };

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduce) {
      render(steps.length);
    } else {
      let n = 0;
      const tick = () => {
        n = n >= steps.length ? 1 : n + 1;
        render(n);
        const ms = n >= steps.length ? steps[steps.length - 1][1] : steps[n - 1][1];
        window.setTimeout(tick, ms);
      };
      tick();
    }
  }
</script>
