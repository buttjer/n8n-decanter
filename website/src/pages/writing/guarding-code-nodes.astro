---
// The article "Free your Code nodes" moved to its canonical home on the
// author's site. This stub keeps every previously shared link working —
// GitHub Pages can't issue server-side redirects, so a meta refresh is the
// mechanism. noindex + a canonical pointing at the new home keep search
// engines on the right copy; the sitemap filter (astro.config.mjs) keeps
// this stub unlisted.
const target = "https://buttjer.net/writing/free-your-code-nodes/";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Free your Code nodes — moved</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={target} />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
  </head>
  <body style="font-family: system-ui, sans-serif; padding: 3rem 1.5rem; text-align: center;">
    <p>This article moved to <a href={target}>{target}</a>.</p>
  </body>
</html>
