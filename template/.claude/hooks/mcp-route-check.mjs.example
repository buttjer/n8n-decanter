#!/usr/bin/env node
// SessionStart config-drift detector (Plan 33): warn when an agent MCP config
// in this sync dir (or an ancestor up to the repo root) — or in the user-level
// config of a known harness (Plan 58 task 2) — points at an n8n instance MCP
// endpoint DIRECTLY instead of the decanter guard-proxy. Deliberately slim — it
// inspects config files, not tool calls (the proxy itself enforces the jsCode
// boundary). Exit 0 always: this is guidance, not a gate. Harness-agnostic: any
// agent hook system (or a shell profile) can run
// `node .claude/hooks/mcp-route-check.mjs`.
import { existsSync, readFileSync } from "node:fs";
import { homedir } from "node:os";
import path from "node:path";

/**
 * The sync dir, found from this script's own location: it is scaffolded at
 * `<syncDir>/.claude/hooks/`, so two levels up IS the sync dir. Never `cwd` —
 * a sync dir nested in a bigger repo gets its hooks spawned with cwd = wherever
 * the agent was started, i.e. the repo root (Plan 81), and
 * `${CLAUDE_PROJECT_DIR}` expands to that same root, never into a descendant.
 */
const SYNC_DIR = path.resolve(import.meta.dirname, "..", "..");

/** Project-scoped agent MCP config files (harness variety, n8n-io/skills style). */
const CONFIG_FILES = [".mcp.json", ".cursor/mcp.json", ".vscode/mcp.json", "opencode.json"];

/**
 * Which directories to look for those files in: the sync dir, then every
 * ancestor up to and including the first one holding a `.git` entry. Claude
 * Code merges `.mcp.json` from every ancestor of the launch cwd, so a routing
 * offender can legitimately live in the parent repo's root file; the git
 * boundary lets the scan see it without wandering into an unrelated parent
 * tree, and with no repo above the sync dir the walk stays put. Consulting git
 * here answers "where is the AGENT's project root?" — not "where is the sync
 * dir?", which is still never git's business. `.git` is a FILE in worktrees and
 * submodules, hence a plain existence check; and the entry is found by looking,
 * not by spawning git, which a SessionStart hook cannot afford.
 */
function scanDirs() {
  const dirs = [];
  let dir = SYNC_DIR;
  let parent = path.dirname(dir);
  while (!existsSync(path.join(dir, ".git"))) {
    dirs.push(dir);
    if (parent === dir) return [SYNC_DIR]; // walked to the filesystem root without a repo
    dir = parent;
    parent = path.dirname(dir);
  }
  dirs.push(dir); // the repo root itself is in scope — the bound is inclusive
  return dirs;
}

/**
 * User-scoped counterparts — the "second door" no project file shows:
 * `claude mcp add -s user` (and its per-project entries), Cursor's global
 * config, the VS Code user profile, opencode's global config. Labels stay
 * `~/…` so the warning names the file the way the user knows it.
 */
function userConfigFiles() {
  const home = homedir();
  const files = [
    ["~/.claude.json", path.join(home, ".claude.json")],
    ["~/.cursor/mcp.json", path.join(home, ".cursor", "mcp.json")],
    ["~/.config/opencode/opencode.json", path.join(home, ".config", "opencode", "opencode.json")],
  ];
  if (process.platform === "darwin") {
    files.push(["~/Library/Application Support/Code/User/mcp.json", path.join(home, "Library", "Application Support", "Code", "User", "mcp.json")]);
  } else if (process.platform === "win32" && process.env.APPDATA) {
    files.push(["%APPDATA%/Code/User/mcp.json", path.join(process.env.APPDATA, "Code", "User", "mcp.json")]);
  } else {
    files.push(["~/.config/Code/User/mcp.json", path.join(home, ".config", "Code", "User", "mcp.json")]);
  }
  return files;
}

/** The running guard-proxy's endpoint, when `n8n-decanter mcp serve` is up. */
function proxyUrl() {
  try {
    return JSON.parse(readFileSync(path.join(SYNC_DIR, ".decanter-proxy.json"), "utf8")).url ?? null;
  } catch {
    return null;
  }
}

function isLoopback(url) {
  try {
    const host = new URL(url).hostname;
    return host === "127.0.0.1" || host === "localhost" || host === "::1";
  } catch {
    return false;
  }
}

/** Collect every MCP server entry (name → config object) across known shapes. */
function serverEntries(config) {
  const bags = [config.mcpServers, config.mcp?.servers, config.servers];
  const entries = [];
  for (const bag of bags) {
    if (bag && typeof bag === "object") entries.push(...Object.entries(bag));
  }
  // opencode's shape is `mcp.<name>` directly (no `servers` nesting) — take its
  // object values, minus a `servers` container the bag above already read.
  if (config.mcp && typeof config.mcp === "object") {
    entries.push(...Object.entries(config.mcp).filter(([key, value]) => key !== "servers" && value && typeof value === "object"));
  }
  return entries;
}

function readJson(file) {
  if (!existsSync(file)) return null;
  try {
    return JSON.parse(readFileSync(file, "utf8"));
  } catch {
    return null; // unparseable config is some other tool's problem
  }
}

/**
 * Is `dir` the sync dir itself, or one of its ancestors? Compares whole path
 * segments, so `/a/foo` does not swallow the sibling `/a/foobar`. Only ABSOLUTE
 * keys count: the bag's keys are absolute by construction, and `path.resolve`
 * would silently anchor a relative (or empty) one at `process.cwd()` — smuggling
 * back the cwd dependence this hook exists to shed (`""` would resolve to cwd
 * and match whenever the agent happened to start in the sync dir).
 */
function isAncestorOrSelf(dir) {
  if (!path.isAbsolute(dir)) return false;
  const base = path.resolve(dir);
  return SYNC_DIR === base || SYNC_DIR.startsWith(base.endsWith(path.sep) ? base : base + path.sep);
}

const proxy = proxyUrl();
const offenders = [];

/** Scan one parsed config; `label` is how the warning names the file. */
function scan(label, config) {
  for (const [name, server] of serverEntries(config)) {
    const text = JSON.stringify(server);
    // the built-in n8n MCP server's path is the giveaway; a loopback URL is
    // the guard-proxy (or a local tunnel the user chose) — leave those alone
    if (!text.includes("/mcp-server/http")) continue;
    const url = typeof server.url === "string" ? server.url : "";
    if (url !== "" && isLoopback(url)) continue;
    offenders.push({ file: label, name, url });
  }
}

// Files the user-scope pass below already reports under the `~/…` names the
// user knows. The ancestor walk can reach the very same file — a sync dir under
// a git-tracked $HOME puts `~/.cursor/mcp.json` on the walk — and naming it
// twice (once as `../.cursor/mcp.json`) reads as two separate offenders.
const userFiles = new Set(userConfigFiles().map(([, file]) => path.resolve(file)));

for (const dir of scanDirs()) {
  for (const name of CONFIG_FILES) {
    const file = path.join(dir, name);
    if (userFiles.has(path.resolve(file))) continue;
    const config = readJson(file);
    // a file in the sync dir keeps its bare name; an ancestor's is named
    // relative to the sync dir (`../.mcp.json`) so the user can tell which
    // of two same-named files the warning is about.
    if (config) scan(dir === SYNC_DIR ? name : path.relative(SYNC_DIR, file), config);
  }
}
for (const [label, file] of userConfigFiles()) {
  const config = readJson(file);
  if (!config) continue;
  scan(label, config);
  // Claude Code's user file also carries per-project servers, keyed by
  // absolute project path — only this project's entry can route this session.
  // That key is the project's canonical GIT ROOT (or, with no repo, the
  // resolved directory), so for a nested sync dir it is an ancestor's path and
  // never the sync dir's: accept any ancestor-or-self key and take the nearest.
  // (Matching `process.cwd()` exactly, as this once did, silently missed every
  // sync dir inside a git repo — Plan 81 task 8a.)
  const projects = config.projects && typeof config.projects === "object" ? config.projects : {};
  let nearest = null;
  for (const key of Object.keys(projects)) {
    if (!isAncestorOrSelf(key)) continue;
    if (nearest === null || path.resolve(key).length > path.resolve(nearest).length) nearest = key;
  }
  const projectBag = nearest === null ? null : projects[nearest]?.mcpServers;
  if (projectBag && typeof projectBag === "object") {
    scan(`${label} (entry for this project)`, { mcpServers: projectBag });
  }
}

if (offenders.length > 0) {
  const target = proxy ?? "http://127.0.0.1:5680/mcp-server/http (start it: n8n-decanter mcp serve)";
  console.log(
    `n8n MCP routing check: ${offenders.map((o) => `"${o.name}" in ${o.file}`).join(", ")} ` +
      `points at an n8n instance MCP endpoint directly. Route it through the decanter guard instead — ` +
      `simplest: the stdio server ({"command":"npx","args":["--no-install","n8n-decanter","mcp","connect"]}, the scaffolded default); ` +
      `or for URL-based configs set its url to ${target} with the Authorization secret \`mcp serve\` prints. ` +
      `The guard forwards everything except Code-node (jsCode) writes, which belong to the file + \`n8n-decanter push\` flow.`,
  );
}
process.exit(0);
