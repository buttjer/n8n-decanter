---
import BaseLayout from "./BaseLayout.astro";
import { href } from "../lib/url";

/**
 * Long-form pages under `/writing/` — public, indexable essays with full
 * social/SEO metadata (og:type article, per-article card, author, JSON-LD).
 * Deliberately NOT part of the `docs` content collection: no sidebar, no
 * prev/next — an essay is not a manual page.
 */
interface Props {
  frontmatter: {
    title: string;
    description: string;
    standfirst?: string;
    date?: string;
    author?: string;
    /** Site-relative path (under public/) to the 1200×630 social card. */
    ogImage?: string;
  };
}

const { title, description, standfirst, date, author, ogImage } = Astro.props.frontmatter;

const dateLabel = date
  ? new Date(`${date}T00:00:00Z`).toLocaleDateString("en-GB", {
      day: "numeric",
      month: "long",
      year: "numeric",
      timeZone: "UTC",
    })
  : undefined;

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const ld = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  ...(date && { datePublished: date }),
  ...(author && { author: { "@type": "Person", name: author } }),
  ...(ogImage && Astro.site && { image: new URL(href(ogImage), Astro.site).toString() }),
  ...(canonical && { mainEntityOfPage: canonical.toString() }),
};
---

<BaseLayout title={`${title} · n8n-decanter`} description={description} ogType="article" image={ogImage}>
  <Fragment slot="head">
    {author && <meta name="author" content={author} />}
    {author && <meta property="article:author" content={author} />}
    {date && <meta property="article:published_time" content={date} />}
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </Fragment>
  <div class="mx-auto w-full max-w-2xl px-4 py-12 sm:px-6">
    {
      (author || dateLabel) && (
        <p class="mb-6 text-xs tracking-wide text-zinc-500 uppercase dark:text-zinc-400">
          {[author, dateLabel].filter(Boolean).join(" · ")}
        </p>
      )
    }
    <article
      class="prose prose-zinc dark:prose-invert max-w-none prose-headings:tracking-tight prose-a:text-accent-700 dark:prose-a:text-accent-300 prose-code:before:content-none prose-code:after:content-none"
    >
      <h1>{title}</h1>
      {standfirst && <p class="lead text-lg text-zinc-600 dark:text-zinc-300">{standfirst}</p>}
      <slot />
    </article>
  </div>
</BaseLayout>
