#!/usr/bin/env node
// PostToolUse verify hook. After an Edit/Write to a Code-node source file, run
// `n8n-decanter preflight --offline` (layout compliance + typecheck, no network,
// no engine) and, on failure, feed the output back to the agent (exit 2 =
// blocking). No-op when the edit isn't a node file, or when the CLI isn't on
// PATH yet (fresh scaffold).
import { spawnSync } from "node:child_process";
import { existsSync, readFileSync } from "node:fs";
import path from "node:path";

let payload = {};
try {
  payload = JSON.parse(readFileSync(0, "utf8") || "{}");
} catch {
  process.exit(0);
}

const file = payload.tool_input?.file_path;
if (!file) process.exit(0);

// A node source file is a .ts/.js (not a .remote.js artifact) that lives in a
// workflow folder's code/ subdir — the .decanter.json sits in the parent
// (legacy layouts had it as a direct sibling).
const dir = path.dirname(file);
const stateDir = existsSync(path.join(dir, ".decanter.json"))
  ? dir
  : path.basename(dir) === "code" && existsSync(path.join(path.dirname(dir), ".decanter.json"))
    ? path.dirname(dir)
    : null;
const isNodeFile = /\.(ts|js)$/.test(file) && !file.endsWith(".remote.js") && stateDir !== null;
if (!isNodeFile) process.exit(0);

// Scope the run to the edited workflow. Refs match on the workflow id stored in
// .decanter.json (NOT the folder name), so read the id from there; if the state
// file is unreadable, fall back to a project-wide run (bare `preflight
// --offline` grades every workflow the config lists, or every pulled one).
let workflowId;
try {
  workflowId = JSON.parse(readFileSync(path.join(stateDir, ".decanter.json"), "utf8")).workflowId;
} catch {}
// --offline keeps the hook where it belongs: layout + typecheck only. No
// instance reads (an edit hook must not need credentials or a reachable n8n)
// and no --simulate (Docker, minutes — an edit hook must stay sub-second).
const args = typeof workflowId === "string" && workflowId
  ? ["preflight", "--offline", workflowId]
  : ["preflight", "--offline"];
const res = spawnSync("n8n-decanter", args, { encoding: "utf8" });
if (res.error?.code === "ENOENT") process.exit(0); // CLI not installed yet — stay quiet

// DELIBERATELY no `--fail-on=warn`. preflight exits 0 on a `caution` verdict, so
// warn-level findings don't block — and that is exactly the old `check`
// behaviour, not a loosening: `check` printed layout warnings and still exited 0,
// failing only on layout errors and a failed typecheck. Under --offline the sync
// tier never runs, so the warns you might want teeth for (`parity`, `drift`) are
// unreachable here; the only reachable warn is a LAYOUT warning, and those are
// states an edit must not be blocked on — a mid-conversion `.js`→`.ts` node whose
// .decanter.json still records the old file ("push to register the change"), or a
// Python Code node whose source stays inline forever. Blocking on the first would
// veto every edit until the agent pushes; on the second, every edit, always.
// Errors still block, which is the whole job of this hook.
if (typeof res.status === "number" && res.status !== 0) {
  const out = ((res.stdout ?? "") + (res.stderr ?? "")).trim();
  console.error(`n8n-decanter preflight --offline failed after editing ${path.basename(file)}:\n${out}`);
  process.exit(2);
}
process.exit(0);
