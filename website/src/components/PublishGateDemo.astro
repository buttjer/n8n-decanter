---
// Looping simulation of the go-live gate: the agent wires an expression to a
// node it never added (a forwarded structure write — the guard only holds
// jsCode), the `publish_workflow` that would ship it is refused with the guard's
// real wording, the agent adds the missing node, re-checks with `test`, and only
// then publishes. Production is on the published version the whole time.
//
// The failing act is deliberately the AGENT's own mistake, not any n8n
// behaviour: the article argues split ownership, not "n8n has a bug".
// Same house pattern as AgentDemo/GuardDemo.
---

<div class="mx-auto w-full max-w-3xl overflow-hidden rounded-xl border border-zinc-800 bg-zinc-950 shadow-lg">
  <div class="flex items-center gap-2 border-b border-zinc-800 px-4 py-2.5">
    <span class="h-3 w-3 rounded-full bg-red-500/80"></span>
    <span class="h-3 w-3 rounded-full bg-yellow-500/80"></span>
    <span class="h-3 w-3 rounded-full bg-green-500/80"></span>
    <span class="ml-2 font-mono text-xs text-zinc-500">coding agent — going live</span>
  </div>
  <div
    id="publish-demo-body"
    role="img"
    aria-label="Animated demo: an agent wires an expression to a node it never added, n8n forwards that structural write, and the publish that would take the broken draft live is refused. The agent adds the missing node, re-checks with test, and publishes. Production keeps serving the published version throughout."
    class="h-[19rem] overflow-hidden px-4 py-3 font-mono text-[12px] leading-[1.6] text-zinc-100 sm:text-[13px]"
  ></div>
</div>

<style>
  #publish-demo-body :global(.who) { color: #a1a1aa; }
  #publish-demo-body :global(.you) { color: #60a5fa; }
  #publish-demo-body :global(.bot) { color: #c4b5fd; }
  #publish-demo-body :global(.tool) { color: #34d399; }
  #publish-demo-body :global(.add) { color: #34d399; }
  #publish-demo-body :global(.ok) { color: #34d399; }
  #publish-demo-body :global(.no) { color: #f87171; }
  #publish-demo-body :global(.dim) { color: #71717a; }
  #publish-demo-body :global(.blk) { margin-top: 0.5rem; }
</style>

<script>
  const body = document.getElementById("publish-demo-body");
  if (body) {
    // Each entry: [html, ms to linger before revealing the next].
    const steps: [string, number][] = [
      ['<div><span class="who you">▌ You</span></div><div>Have Totals use the customer tier, then take it live.</div>', 1400],
      ['<div class="blk"><span class="tool">⏺ n8n MCP</span> update_workflow · setNodeParameter "Totals"</div><div class="dim">&nbsp;&nbsp;={{ $(\'Customer lookup\').first().json.tier }}</div><div class="ok">✓ forwarded — structure writes pass; only jsCode is held</div>', 2000],
      ['<div class="blk"><span class="tool">⏺ n8n MCP</span> publish_workflow wf_8kQ2</div><div class="no">✗ blocked by the n8n-decanter guard-proxy: 1 dangling reference(s) on the draft of wf_8kQ2 would go live.</div><div class="dim">expression parameters (structure — fix in n8n, not in workflow.json):</div><div class="dim">&nbsp;&nbsp;node "Totals" references $(\'Customer lookup\')</div><div class="dim">then re-check with: n8n-decanter test wf_8kQ2</div>', 3000],
      ['<div class="blk"><span class="who bot">▌ Agent</span></div><div>That node isn\'t there — I planned it and never added it. Nothing went live.</div>', 1900],
      ['<div class="blk"><span class="tool">⏺ n8n MCP</span> update_workflow · addNode "Customer lookup" + addConnection</div><div class="ok">✓ forwarded — node created and wired</div>', 1800],
      ['<div class="blk"><span class="tool">⏺ Run</span> n8n-decanter test "Order enrichment"</div><div class="ok">✓ draft is statically clean; nothing was executed</div>', 1800],
      ['<div class="blk"><span class="tool">⏺ n8n MCP</span> publish_workflow wf_8kQ2</div><div class="ok">✓ forwarded — published</div><div class="dim">Production ran the old version until this line. It never saw the broken one.</div>', 2900],
    ];

    const render = (n: number) => {
      body.innerHTML = steps.slice(0, n).map((s) => s[0]).join("");
      // Keep the newest line in view — the panel scrolls, it doesn't resize.
      body.scrollTop = body.scrollHeight;
    };

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduce) {
      render(steps.length);
    } else {
      let n = 0;
      const tick = () => {
        n = n >= steps.length ? 1 : n + 1;
        render(n);
        const ms = n >= steps.length ? steps[steps.length - 1][1] : steps[n - 1][1];
        window.setTimeout(tick, ms);
      };
      tick();
    }
  }
</script>
