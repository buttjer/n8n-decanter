---
import BaseLayout from "./BaseLayout.astro";

/**
 * Long-form pages under `/writing/`. Deliberately NOT part of the `docs`
 * content collection, which is what keeps these out of the sidebar, the
 * prev/next chain, and `llms.txt` — no allowlist to maintain. Paired with
 * `noindex` and a sitemap exclusion (astro.config.mjs), a page here is
 * reachable only by someone holding the link.
 */
interface Props {
  frontmatter: {
    title: string;
    description: string;
    standfirst?: string;
    date?: string;
  };
}

const { title, description, standfirst, date } = Astro.props.frontmatter;

const dateLabel = date
  ? new Date(`${date}T00:00:00Z`).toLocaleDateString("en-GB", {
      day: "numeric",
      month: "long",
      year: "numeric",
      timeZone: "UTC",
    })
  : undefined;
---

<BaseLayout title={`${title} · n8n-decanter`} description={description} noindex>
  <div class="mx-auto w-full max-w-2xl px-4 py-12 sm:px-6">
    <p class="mb-6 text-xs tracking-wide text-zinc-500 uppercase dark:text-zinc-400">
      Unlisted draft{dateLabel && ` · ${dateLabel}`}
    </p>
    <article
      class="prose prose-zinc dark:prose-invert max-w-none prose-headings:tracking-tight prose-a:text-accent-700 dark:prose-a:text-accent-300 prose-code:before:content-none prose-code:after:content-none"
    >
      <h1>{title}</h1>
      {standfirst && <p class="lead text-lg text-zinc-600 dark:text-zinc-300">{standfirst}</p>}
      <slot />
    </article>
  </div>
</BaseLayout>
